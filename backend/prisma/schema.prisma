generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model activity_logs {
  id         String               @id @db.VarChar(36)
  user_id    String?              @db.VarChar(36)
  module     String               @db.VarChar(50)
  action     activity_logs_action
  ip_address String?              @db.VarChar(45)
  user_agent String?              @db.VarChar(255)
  metadata   String?              @db.LongText
  created_at DateTime             @default(now()) @db.DateTime(0)
  users      users?               @relation(fields: [user_id], references: [id], map: "fk_activity_logs_user_id")

  @@index([created_at], map: "idx_activity_logs_created_at")
  @@index([module], map: "idx_activity_logs_module")
  @@index([user_id], map: "idx_activity_logs_user_id")
}

model artists {
  id            String          @id @db.VarChar(36)
  name          String          @db.VarChar(100)
  genre         String?         @db.VarChar(50)
  bio           String?         @db.Text
  image         String?         @db.Text
  created_at    DateTime        @default(now()) @db.DateTime(0)
  updated_at    DateTime        @default(now()) @db.DateTime(0)
  deleted_at    DateTime?       @db.DateTime(0)
  event_artists event_artists[]

  @@index([name], map: "idx_artists_name")
}

model event_artists {
  event_id  String  @db.VarChar(36)
  artist_id String  @db.VarChar(36)
  artists   artists @relation(fields: [artist_id], references: [id], onDelete: Cascade, map: "fk_event_artists_artist_id")
  events    events  @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "fk_event_artists_event_id")

  @@id([event_id, artist_id])
  @@index([artist_id], map: "idx_event_artists_artist_id")
}

model event_images {
  id         String   @id @db.VarChar(36)
  event_id   String   @db.VarChar(36)
  image_url  String   @db.Text
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.DateTime(0)
  events     events   @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "fk_event_images_event_id")

  @@index([event_id], map: "idx_event_images_event_id")
}

model events {
  id                String              @id @db.VarChar(36)
  organizer_id      String              @db.VarChar(36)
  venue_id          String              @db.VarChar(36)
  title             String              @db.VarChar(200)
  slug              String              @unique(map: "uq_events_slug") @db.VarChar(250)
  description       String              @db.Text
  banner            String?             @db.Text
  start_date        DateTime            @db.DateTime(0)
  end_date          DateTime            @db.DateTime(0)
  status            events_status       @default(DRAFT)
  created_at        DateTime            @default(now()) @db.DateTime(0)
  updated_at        DateTime            @default(now()) @db.DateTime(0)
  deleted_at        DateTime?           @db.DateTime(0)
  event_artists     event_artists[]
  event_images      event_images[]
  organizers        organizers          @relation(fields: [organizer_id], references: [id], map: "fk_events_organizer_id")
  venues            venues              @relation(fields: [venue_id], references: [id], map: "fk_events_venue_id")
  favorites         favorites[]
  ticket_categories ticket_categories[]

  @@index([start_date, end_date], map: "idx_events_dates")
  @@index([organizer_id], map: "idx_events_organizer")
  @@index([status], map: "idx_events_status")
  @@index([venue_id], map: "idx_events_venue")
}

model favorites {
  user_id    String   @db.VarChar(36)
  event_id   String   @db.VarChar(36)
  created_at DateTime @default(now()) @db.DateTime(0)
  events     events   @relation(fields: [event_id], references: [id], onDelete: Cascade, map: "fk_favorites_event_id")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_favorites_user_id")

  @@id([user_id, event_id])
  @@index([event_id], map: "idx_favorites_event_id")
}

model notifications {
  id                String                          @id @db.VarChar(36)
  user_id           String                          @db.VarChar(36)
  title             String                          @db.VarChar(200)
  message           String                          @db.Text
  notification_type notifications_notification_type
  is_read           Boolean                         @default(false)
  created_at        DateTime                        @default(now()) @db.DateTime(0)
  updated_at        DateTime                        @default(now()) @db.DateTime(0)
  deleted_at        DateTime?                       @db.DateTime(0)
  users             users                           @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_notifications_user_id")

  @@index([user_id, is_read], map: "idx_notifications_user_unread")
}

model order_items {
  id                 String            @id @db.VarChar(36)
  order_id           String            @db.VarChar(36)
  ticket_category_id String            @db.VarChar(36)
  quantity           Int
  unit_price         Decimal           @db.Decimal(12, 2)
  subtotal           Decimal           @db.Decimal(14, 2)
  created_at         DateTime          @default(now()) @db.DateTime(0)
  updated_at         DateTime          @default(now()) @db.DateTime(0)
  ticket_categories  ticket_categories @relation(fields: [ticket_category_id], references: [id], map: "fk_order_items_category_id")
  orders             orders            @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "fk_order_items_order_id")
  tickets            tickets[]

  @@index([ticket_category_id], map: "idx_order_items_category_id")
  @@index([order_id], map: "idx_order_items_order_id")
}

model orders {
  id             String        @id @db.VarChar(36)
  user_id        String        @db.VarChar(36)
  invoice_number String        @unique(map: "uq_orders_invoice") @db.VarChar(50)
  total_amount   Decimal       @db.Decimal(14, 2)
  status         orders_status @default(PENDING)
  expires_at     DateTime      @db.DateTime(0)
  created_at     DateTime      @default(now()) @db.DateTime(0)
  updated_at     DateTime      @default(now()) @db.DateTime(0)
  deleted_at     DateTime?     @db.DateTime(0)
  order_items    order_items[]
  users          users         @relation(fields: [user_id], references: [id], map: "fk_orders_user_id")
  payments       payments[]

  @@index([status], map: "idx_orders_status")
  @@index([user_id], map: "idx_orders_user_id")
}

model organizers {
  id          String    @id @db.VarChar(36)
  user_id     String    @unique(map: "uq_organizers_user_id") @db.VarChar(36)
  org_name    String    @db.VarChar(150)
  description String?   @db.Text
  logo        String?   @db.Text
  website     String?   @db.VarChar(255)
  is_approved Boolean   @default(false)
  created_at  DateTime  @default(now()) @db.DateTime(0)
  updated_at  DateTime  @default(now()) @db.DateTime(0)
  deleted_at  DateTime? @db.DateTime(0)
  events      events[]
  users       users     @relation(fields: [user_id], references: [id], map: "fk_organizers_user_id")

  @@index([is_approved], map: "idx_organizers_is_approved")
}

model payments {
  id                 String          @id @db.VarChar(36)
  order_id           String          @db.VarChar(36)
  midtrans_id        String?         @unique(map: "uq_payments_midtrans_id") @db.VarChar(100)
  snap_token         String?         @db.VarChar(255)
  snap_url           String?         @db.Text
  amount             Decimal         @db.Decimal(14, 2)
  method             String?         @db.VarChar(50)
  status             payments_status @default(PENDING)
  transaction_id     String?         @unique(map: "uq_payments_transaction_id") @db.VarChar(100)
  payment_type       String?         @db.VarChar(50)
  transaction_status String?         @db.VarChar(50)
  fraud_status       String?         @db.VarChar(50)
  expiry_time        DateTime?       @db.DateTime(0)
  paid_at            DateTime?       @db.DateTime(0)
  raw_response       String?         @db.LongText
  created_at         DateTime        @default(now()) @db.DateTime(0)
  updated_at         DateTime        @default(now()) @db.DateTime(0)
  deleted_at         DateTime?       @db.DateTime(0)
  orders             orders          @relation(fields: [order_id], references: [id], map: "fk_payments_order_id")

  @@index([order_id], map: "idx_payments_order_id")
  @@index([status], map: "idx_payments_status")
}

model roles {
  id         String     @id @db.VarChar(36)
  name       roles_name @unique(map: "uq_roles_name")
  created_at DateTime   @default(now()) @db.DateTime(0)
  updated_at DateTime   @default(now()) @db.DateTime(0)
  users      users[]
}

model ticket_categories {
  id          String        @id @db.VarChar(36)
  event_id    String        @db.VarChar(36)
  name        String        @db.VarChar(100)
  price       Decimal       @db.Decimal(12, 2)
  quota       Int
  sold        Int           @default(0)
  sale_start  DateTime      @db.DateTime(0)
  sale_end    DateTime      @db.DateTime(0)
  created_at  DateTime      @default(now()) @db.DateTime(0)
  updated_at  DateTime      @default(now()) @db.DateTime(0)
  deleted_at  DateTime?     @db.DateTime(0)
  order_items order_items[]
  events      events        @relation(fields: [event_id], references: [id], map: "fk_ticket_categories_event_id")

  @@index([event_id], map: "idx_ticket_categories_event_id")
}

model ticket_scans {
  id              String   @id @db.VarChar(36)
  ticket_id       String   @db.VarChar(36)
  scanned_at      DateTime @default(now()) @db.DateTime(0)
  location        String?  @db.VarChar(200)
  scanner_user_id String?  @db.VarChar(36)
  created_at      DateTime @default(now()) @db.DateTime(0)
  users           users?   @relation(fields: [scanner_user_id], references: [id], map: "fk_ticket_scans_scanner_id")
  tickets         tickets  @relation(fields: [ticket_id], references: [id], map: "fk_ticket_scans_ticket_id")

  @@index([scanner_user_id], map: "idx_ticket_scans_scanner")
  @@index([ticket_id], map: "idx_ticket_scans_ticket_id")
}

model tickets {
  id             String         @id @db.VarChar(36)
  order_item_id  String         @db.VarChar(36)
  qr_code        String         @unique(map: "uq_tickets_qr_code") @db.VarChar(255)
  qr_image       String?        @db.Text
  attendee_name  String         @db.VarChar(100)
  attendee_email String         @db.VarChar(255)
  attendee_phone String         @db.VarChar(20)
  status         tickets_status @default(ACTIVE)
  created_at     DateTime       @default(now()) @db.DateTime(0)
  updated_at     DateTime       @default(now()) @db.DateTime(0)
  deleted_at     DateTime?      @db.DateTime(0)
  ticket_scans   ticket_scans[]
  order_items    order_items    @relation(fields: [order_item_id], references: [id], map: "fk_tickets_order_item_id")

  @@index([order_item_id], map: "idx_tickets_order_item_id")
  @@index([status], map: "idx_tickets_status")
}

model users {
  id            String          @id @db.VarChar(36)
  role_id       String          @db.VarChar(36)
  name          String          @db.VarChar(100)
  email         String          @unique(map: "uq_users_email") @db.VarChar(255)
  password      String          @db.VarChar(255)
  phone         String?         @db.VarChar(20)
  avatar        String?         @db.Text
  is_verified   Boolean         @default(false)
  created_at    DateTime        @default(now()) @db.DateTime(0)
  updated_at    DateTime        @default(now()) @db.DateTime(0)
  deleted_at    DateTime?       @db.DateTime(0)
  activity_logs activity_logs[]
  favorites     favorites[]
  notifications notifications[]
  orders        orders[]
  organizers    organizers?
  ticket_scans  ticket_scans[]
  roles         roles           @relation(fields: [role_id], references: [id], map: "fk_users_role_id")

  @@index([role_id], map: "idx_users_role_id")
}

model venues {
  id         String    @id @db.VarChar(36)
  name       String    @db.VarChar(150)
  address    String    @db.Text
  city       String    @db.VarChar(100)
  province   String    @db.VarChar(100)
  capacity   Int
  map_url    String?   @db.Text
  image      String?   @db.Text
  created_at DateTime  @default(now()) @db.DateTime(0)
  updated_at DateTime  @default(now()) @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)
  events     events[]

  @@index([city, province], map: "idx_venues_city_province")
}

enum roles_name {
  USER
  ORGANIZER
  ADMIN
  SUPER_ADMIN
}

enum activity_logs_action {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  SCAN
  PAYMENT
}

enum notifications_notification_type {
  ORDER
  PAYMENT
  EVENT
  SYSTEM
  ACCOUNT
}

enum orders_status {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum payments_status {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum tickets_status {
  ACTIVE
  USED
  CANCELLED
  EXPIRED
}

enum events_status {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  SOLD_OUT
  FINISHED
  CANCELLED
}
